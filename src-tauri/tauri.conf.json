{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Module",
  "version": "2.1.8",
  "identifier": "com.module.taskmanager",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Module",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "url": "index.html",
        "dragDropEnabled": false
      },
      {
        "label": "widget",
        "title": "Module 便签",
        "width": 320,
        "height": 480,
        "minWidth": 280,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "widget.html",
        "dragDropEnabled": false
      },
      {
        "label": "reminder",
        "title": "任务提醒",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false,
        "url": "reminder.html",
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 440,
        "height": 640,
        "resizable": false,
        "visible": false,
        "url": "settings.html",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
